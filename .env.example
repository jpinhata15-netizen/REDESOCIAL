# =====================================================
# CONECTA SOCIAL — Variáveis de Ambiente de Produção
# =====================================================
# Copie este arquivo como .env e preencha os valores.
# NUNCA envie o .env real ao GitHub!

# -----------------------------------------------
# Banco de Dados PostgreSQL (Supabase)
# Obtido em: Supabase > Project Settings > Database > Connection String
# -----------------------------------------------
# URL pooled (usada pelo Next.js serverless na Vercel)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta (usada pelo prisma migrate/push)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------
# Segurança — JWT
# Gere uma chave segura com: openssl rand -base64 64
# -----------------------------------------------
JWT_SECRET="sua-chave-jwt-secreta-e-longa-para-producao"

# -----------------------------------------------
# Identidade da Marca (públicas, sem segredo)
# -----------------------------------------------
NEXT_PUBLIC_APP_NAME="Conecta"
NEXT_PUBLIC_APP_URL="https://seu-dominio.vercel.app"
