# Banco de Dados Local (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# Segurança e Autenticação (Gere uma chave secreta forte em produção)
JWT_SECRET="seu-jwt-secret-de-producao"

# Identidade da Marca
NEXT_PUBLIC_APP_NAME="Conecta"
NEXT_PUBLIC_APP_DESCRIPTION="A rede social brasileira feita para conexões autênticas"

# Supabase (Preencha caso utilize a infraestrutura em nuvem)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-privada"
